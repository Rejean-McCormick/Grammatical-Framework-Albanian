-- Albanian large lexical/syntactic dictionary.
-- Baseline LexiconSqi entries are reused exactly when available.
-- Albanet-only entries use ParadigmsSqi smart constructors and require progressive linguistic review.

concrete DictSqi of DictSqiAbs = CatSqi **
  open ParadigmsSqi, (I = IrregSqi), (L = LexiconSqi), (R = ResSqi), Prelude in {

flags
  coding=utf8 ;
  optimize=values ;

oper
  -- Compile-safe placeholders for imported lexical items whose Albanian paradigm
  -- has not yet been linguistically certified. Exact LexiconSqi aliases are unchanged.
  invariantN : Str -> N = \x -> lin N {
    s = table {
      Indef => table {MNom => table {Sg => x ; Pl => x} ; MAcc => table {Sg => x ; Pl => x} ; MDat => table {Sg => x ; Pl => x} ; MAblat => table {Sg => x ; Pl => x}} ;
      Def   => table {MNom => table {Sg => x ; Pl => x} ; MAcc => table {Sg => x ; Pl => x} ; MDat => table {Sg => x ; Pl => x} ; MAblat => table {Sg => x ; Pl => x}}
    } ;
    g = table {Sg => masculine ; Pl => masculine}
  } ;
  invariantA : Str -> A = \x -> lin A {
    s = table {Masc => table {Sg => x ; Pl => x} ; Fem => table {Sg => x ; Pl => x}} ;
    cls = unarticulatedAdjClass
  } ;
  invariantV : Str -> V = \x -> irregV x x x x x x x x x ;

lin
