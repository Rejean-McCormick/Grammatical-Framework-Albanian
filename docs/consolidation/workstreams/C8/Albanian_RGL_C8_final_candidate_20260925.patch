+
+  -- Tense-general Standard-Albanian progressive.  po + finite verb is not
+  -- compositional across the whole public RGL tense space; jam + duke +
+  -- participle is.  Public Past maps to the Albanian Aorist slot, therefore
+  -- the progressive copula deliberately places the copular imperfect in that
+  -- slot (isha duke ...), while anterior forms naturally become kam qenë duke ... .
+  progressiveVPWithCopula : Verb -> VP -> VP = \cop,vp ->
+    let base : VP = emptyVP cop
+    in base ** {
+      indicative = table {
+        Pres => cop.Indicative ! Pres ;
+        Past => cop.Indicative ! Past ;
+        Aorist => cop.Indicative ! Imperfect ;
+        Imperfect => cop.Indicative ! Imperfect
+      } ;
+      post = \\a => "duke" ++ vp.cl ++ vp.participle ++ vp.post ! a
