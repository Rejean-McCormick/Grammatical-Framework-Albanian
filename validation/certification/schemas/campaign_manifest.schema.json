{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "albanian-c10-campaign-v1",
  "type": "object",
  "required": ["schema", "level", "case_count", "source_lock_sha256", "scenario_ids", "language_variety"],
  "properties": {
    "schema": {"const": "albanian-c10-campaign-v1"},
    "level": {"enum": ["G1", "G2", "G3"]},
    "case_count": {"type": "integer", "minimum": 1},
    "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "language_variety": {"const": "Standard Albanian"}
  },
  "additionalProperties": false
}
