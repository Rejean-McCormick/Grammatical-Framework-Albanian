{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "albanian-c10-gold-promotion-v1",
  "type": "object",
  "required": ["schema", "scenario_id", "request_id", "source_lock_sha256", "output_sha256", "decision_ref", "reviewer_kind", "reviewer_name", "case_ids", "language_variety"],
  "properties": {
    "schema": {"const": "albanian-c10-gold-promotion-v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_ref": {"type": "string", "minLength": 1},
    "reviewer_kind": {"enum": ["ai", "human", "dual"]},
    "reviewer_name": {"type": "string", "minLength": 1},
    "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "language_variety": {"const": "Standard Albanian"}
  },
  "additionalProperties": true
}
