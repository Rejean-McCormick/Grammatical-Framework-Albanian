  lincat Probe = {s : Str} ;
  lin
    C0241 = {s = (L.new_A).s ! Nom ! Masc ! Sg} ;
    C0242 = {s = (L.new_A).s ! Nom ! Fem ! Sg} ;
    C0243 = {s = (L.new_A).s ! Nom ! Masc ! Pl} ;
